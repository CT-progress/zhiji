# LLM 默认值（Web 配置页可覆盖）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 输出与转写
OUTPUT_DIR=D:\DOUYIN-search\output
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
KEEP_AUDIO=false

# 配置文件位置
ZHIJI_CONFIG=D:\DOUYIN-search\config\zhiji.json

# 平台 Cookie（可选，仅搜索/受限内容需要）
DOUYIN_COOKIE_FILE=
XHS_COOKIE_FILE=
BILIBILI_COOKIE_FILE=

# 缓存重定向：保证占用都在 D 盘项目内
HF_HOME=D:\DOUYIN-search\.cache\huggingface
UV_CACHE_DIR=D:\DOUYIN-search\.cache\uv
PLAYWRIGHT_BROWSERS_PATH=D:\DOUYIN-search\ms-playwright
PIP_CACHE_DIR=D:\DOUYIN-search\.cache\pip
XDG_CACHE_HOME=D:\DOUYIN-search\.cache\xdg
TEMP=D:\DOUYIN-search\.tmp
TMP=D:\DOUYIN-search\.tmp
