# LLM 默认值（Web 配置页可覆盖）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 输出与转写
# 相对路径以项目根目录为基准（也可填绝对路径）
OUTPUT_DIR=output
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
KEEP_AUDIO=false

# 配置文件位置（相对路径以项目根目录为基准）
ZHIJI_CONFIG=config/zhiji.json

# 平台 Cookie（可选，仅搜索/受限内容需要）
DOUYIN_COOKIE_FILE=
XHS_COOKIE_FILE=
BILIBILI_COOKIE_FILE=

# 缓存重定向：把占用都留在项目目录内（相对路径以启动时的工作目录为基准，
# start.bat 会把工作目录切到项目根目录，因此下面的相对路径等价于“项目内”）
HF_HOME=.cache/huggingface
UV_CACHE_DIR=.cache/uv
PLAYWRIGHT_BROWSERS_PATH=ms-playwright
PIP_CACHE_DIR=.cache/pip
XDG_CACHE_HOME=.cache/xdg
TEMP=.tmp
TMP=.tmp
