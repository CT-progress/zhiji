# LLM 默认值（Web 配置页可覆盖）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 输出与转写
# 相对路径以项目根目录为基准（也可填绝对路径）
OUTPUT_DIR=output
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
KEEP_AUDIO=false

# 配置文件位置（相对路径以项目根目录为基准）
ZHIJI_CONFIG=config/zhiji.json

# 数据库连接串（不填则使用项目内 data/zhiji.db）
# SQLite：sqlite:///data/zhiji.db
# PostgreSQL：postgresql+psycopg://user:pass@localhost:5432/zhiji
ZHIJI_DATABASE_URL=

# 会话存储后端：db（默认，写入上面的数据库）或 json（回退 data/conversations.json）
ZHIJI_CHAT_BACKEND=db

# 配置存储后端：db（默认，写数据库并在 ZHIJI_CONFIG 留一份 JSON 导出）或 json（纯文件）
ZHIJI_CONFIG_BACKEND=db

# 账号会话签名密钥：留空则首次使用时生成 data/.session_secret（重启后仍有效）
# 生产环境请显式设置一个长随机串，避免多实例之间会话不通用
ZHIJI_SECRET_KEY=

# 会话有效期（秒），默认 7 天
# ZHIJI_SESSION_TTL=604800

# bcrypt 代价因子（4-16），默认 12；仅测试环境建议调低
# ZHIJI_BCRYPT_ROUNDS=12

# 凭据加密主密钥（阶段 4 起用于加密 LLM Key / 平台 Cookie）
# 留空则首次使用时自动生成 data/.master_key（在 .gitignore 内，不会进版本库）。
# 内容为 32 字节密钥的 URL-safe Base64，可这样生成：
#   .venv\Scripts\python.exe -c "from zhiji.security import generate_master_key; print(generate_master_key())"
# 生产环境建议显式设置，多实例共用同一把密钥。
# 警告：主密钥丢失后，已加密的凭据无法恢复，只能重新录入。
ZHIJI_MASTER_KEY=

# 主密钥文件位置（可选；相对路径以项目根目录为基准，默认 data/.master_key）
# ZHIJI_MASTER_KEY_PATH=

# 账号鉴权开关：1/true/yes/on 开启后，除注册/登录/登出/健康检查外的 /api 接口都要求登录
# 默认关闭，保持本机零配置直接可用；对外部署请开启或改用 --require-auth
# ZHIJI_REQUIRE_AUTH=0

# 平台 Cookie（可选，仅搜索/受限内容需要）
DOUYIN_COOKIE_FILE=
XHS_COOKIE_FILE=
BILIBILI_COOKIE_FILE=

# 缓存重定向：把占用都留在项目目录内（相对路径以启动时的工作目录为基准，
# start.bat 会把工作目录切到项目根目录，因此下面的相对路径等价于“项目内”）
HF_HOME=.cache/huggingface
UV_CACHE_DIR=.cache/uv
PLAYWRIGHT_BROWSERS_PATH=ms-playwright
PIP_CACHE_DIR=.cache/pip
XDG_CACHE_HOME=.cache/xdg
TEMP=.tmp
TMP=.tmp
